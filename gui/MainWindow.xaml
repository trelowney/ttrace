<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="TtraceGui.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:TtraceGui"
    Title="ttrace">

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" Padding="20,16,20,20" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="160" />
            <RowDefinition Height="*" MinHeight="180" />
        </Grid.RowDefinitions>

        <!-- what to trace -->
        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="TargetBox"
                     Header="Host name or IP address to trace"
                     PlaceholderText="for example example.com or 1.1.1.1"
                     KeyDown="TargetBox_KeyDown" />
            <ComboBox x:Name="FamilyBox" Grid.Column="1"
                      Header="IP version" MinWidth="150" SelectedIndex="0"
                      VerticalAlignment="Bottom"
                      SelectionChanged="FamilyBox_SelectionChanged">
                <ComboBoxItem Content="Automatic" />
                <ComboBoxItem Content="IPv4 only" />
                <ComboBoxItem Content="IPv6 only" />
            </ComboBox>
            <Button x:Name="StartButton" Grid.Column="2"
                    Content="Start" MinWidth="110" VerticalAlignment="Bottom"
                    Style="{StaticResource AccentButtonStyle}"
                    Click="StartButton_Click" />
        </Grid>

        <!-- messages: always with a way out (close, and "Try again" for errors) -->
        <InfoBar x:Name="Info" Grid.Row="1" IsOpen="False" IsClosable="True">
            <InfoBar.ActionButton>
                <Button x:Name="InfoAction" Content="Try again" Click="InfoAction_Click" />
            </InfoBar.ActionButton>
        </InfoBar>

        <TextBlock x:Name="Summary" Grid.Row="2" TextWrapping="Wrap"
                   Style="{StaticResource BodyStrongTextBlockStyle}" />

        <!-- hop table -->
        <Border Grid.Row="3" CornerRadius="8" BorderThickness="1"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Padding="12,8" ColumnSpacing="8"
                      BorderThickness="0,0,0,1"
                      BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="36" />
                        <ColumnDefinition Width="*" MinWidth="180" />
                        <ColumnDefinition Width="84" />
                        <ColumnDefinition Width="160" />
                        <ColumnDefinition Width="32" />
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="64" />
                        <ColumnDefinition Width="44" />
                        <ColumnDefinition Width="56" />
                        <ColumnDefinition Width="56" />
                        <ColumnDefinition Width="56" />
                        <ColumnDefinition Width="56" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="#" Style="{StaticResource CaptionTextBlockStyle}" HorizontalAlignment="Right" />
                    <TextBlock Grid.Column="1" Text="Router" Style="{StaticResource CaptionTextBlockStyle}" />
                    <TextBlock Grid.Column="2" Text="Network" Style="{StaticResource CaptionTextBlockStyle}" />
                    <TextBlock Grid.Column="3" Text="Network name" Style="{StaticResource CaptionTextBlockStyle}" />
                    <TextBlock Grid.Column="4" Text="CC" Style="{StaticResource CaptionTextBlockStyle}" ToolTipService.ToolTip="Country where the network is registered" />
                    <TextBlock Grid.Column="5" Text="Place (approx.)" Style="{StaticResource CaptionTextBlockStyle}" />
                    <TextBlock Grid.Column="6" Text="Loss" Style="{StaticResource CaptionTextBlockStyle}" HorizontalAlignment="Right" ToolTipService.ToolTip="Share of probes without an answer" />
                    <TextBlock Grid.Column="7" Text="Sent" Style="{StaticResource CaptionTextBlockStyle}" HorizontalAlignment="Right" />
                    <TextBlock Grid.Column="8" Text="Last ms" Style="{StaticResource CaptionTextBlockStyle}" HorizontalAlignment="Right" />
                    <TextBlock Grid.Column="9" Text="Avg ms" Style="{StaticResource CaptionTextBlockStyle}" HorizontalAlignment="Right" />
                    <TextBlock Grid.Column="10" Text="Best ms" Style="{StaticResource CaptionTextBlockStyle}" HorizontalAlignment="Right" />
                    <TextBlock Grid.Column="11" Text="Worst ms" Style="{StaticResource CaptionTextBlockStyle}" HorizontalAlignment="Right" />
                </Grid>

                <ListView x:Name="HopList" Grid.Row="1" SelectionMode="None"
                          ItemsSource="{x:Bind Rows}">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="12,0" />
                            <Setter Property="MinHeight" Value="30" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="local:HopRow">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="36" />
                                    <ColumnDefinition Width="*" MinWidth="180" />
                                    <ColumnDefinition Width="84" />
                                    <ColumnDefinition Width="160" />
                                    <ColumnDefinition Width="32" />
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="64" />
                                    <ColumnDefinition Width="44" />
                                    <ColumnDefinition Width="56" />
                                    <ColumnDefinition Width="56" />
                                    <ColumnDefinition Width="56" />
                                    <ColumnDefinition Width="56" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{x:Bind Ttl, Mode=OneWay}" HorizontalAlignment="Right" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Grid.Column="1" Text="{x:Bind Host, Mode=OneWay}" TextTrimming="CharacterEllipsis" IsTextSelectionEnabled="True" />
                                <TextBlock Grid.Column="2" Text="{x:Bind Asn, Mode=OneWay}" />
                                <TextBlock Grid.Column="3" Text="{x:Bind AsName, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="4" Text="{x:Bind Country, Mode=OneWay}" />
                                <TextBlock Grid.Column="5" Text="{x:Bind PlaceName, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="6" Text="{x:Bind Loss, Mode=OneWay}" HorizontalAlignment="Right" />
                                <TextBlock Grid.Column="7" Text="{x:Bind Sent, Mode=OneWay}" HorizontalAlignment="Right" />
                                <TextBlock Grid.Column="8" Text="{x:Bind Last, Mode=OneWay}" HorizontalAlignment="Right" />
                                <TextBlock Grid.Column="9" Text="{x:Bind Avg, Mode=OneWay}" HorizontalAlignment="Right" />
                                <TextBlock Grid.Column="10" Text="{x:Bind Best, Mode=OneWay}" HorizontalAlignment="Right" />
                                <TextBlock Grid.Column="11" Text="{x:Bind Worst, Mode=OneWay}" HorizontalAlignment="Right" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <TextBlock x:Name="TableEmpty" Grid.Row="1" Margin="24"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           TextAlignment="Center" TextWrapping="Wrap"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </Grid>
        </Border>

        <!-- map -->
        <Border Grid.Row="4" CornerRadius="8" BorderThickness="1"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
            <Grid>
                <Canvas x:Name="MapCanvas" Background="Transparent" SizeChanged="MapCanvas_SizeChanged">
                    <Path x:Name="LandWest" Fill="{ThemeResource SystemControlBackgroundBaseLowBrush}" />
                    <Path x:Name="LandMid" Fill="{ThemeResource SystemControlBackgroundBaseLowBrush}" />
                    <Path x:Name="LandEast" Fill="{ThemeResource SystemControlBackgroundBaseLowBrush}" />
                    <Polyline x:Name="RouteLine" StrokeThickness="2.5" StrokeLineJoin="Round"
                              Stroke="{ThemeResource AccentFillColorDefaultBrush}" />
                    <Canvas x:Name="Markers" />
                </Canvas>
                <!-- only used as a source of a theme colour for the target marker -->
                <Rectangle x:Name="TargetBrushSource" Visibility="Collapsed"
                           Fill="{ThemeResource SystemFillColorSuccessBrush}" />
                <Border x:Name="MapNoteBox" Margin="12" MaxWidth="560" Padding="12,8"
                        HorizontalAlignment="Left" VerticalAlignment="Top" CornerRadius="6"
                        Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">
                    <StackPanel Spacing="8">
                        <TextBlock x:Name="MapNote" TextWrapping="Wrap" />
                        <Button x:Name="MapRetry" Content="Try again" Visibility="Collapsed"
                                Click="MapRetry_Click" />
                    </StackPanel>
                </Border>
                <TextBlock Margin="12,8" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Text="Places are approximate · IP locations: DB-IP.com (CC BY 4.0) · Map: Natural Earth" />
            </Grid>
        </Border>
    </Grid>
</Window>
